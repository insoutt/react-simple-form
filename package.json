  "description": "Build react dynamic forms using JSON format",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "ci": "yarn build && yarn check-format && yarn test",
    "format": "prettier --write .",

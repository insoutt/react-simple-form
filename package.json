    "test": "vitest run",
    "dev": "vitest",
    "local-release": "changeset version && changeset publish",
    "prepublishOnly": "npm run ci"
  },
  "keywords": [
    "form",
    "react form",
    "form builder",
    "typescript"
  ],
  "homepage": "https://github.com/insoutt/react-simple-form",
